# ------------------------------------------------------------------
# Copy to .env.local for local dev, and add the same keys in Vercel
# (Project -> Settings -> Environment Variables).
# ------------------------------------------------------------------

# Supabase lead storage. Use the service_role key so the insert bypasses RLS.
# Without these two, the request form shows "call us instead" rather than
# silently dropping the lead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical origin used for metadata, sitemap and JSON-LD.
# Set this to the real domain once it is pointed at the site.
NEXT_PUBLIC_SITE_URL=https://southern-breeze-hvac.vercel.app
